<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/carbon_oscuro"
    android:fitsSystemWindows="true">

    <!-- ENCABEZADO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="135dp"
        android:gravity="bottom|center"
        android:background="@color/rojo_carmesi"
        android:orientation="vertical"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Regístrate"
            android:textColor="#000000"
            android:textSize="38sp"
            android:textStyle="bold"
            android:fontFamily="serif" />

    </LinearLayout>

    <!-- CONTENIDO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- BOTON VOLVER -->
        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back" />

        <!-- NOMBRE USUARIO -->
        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field"
            android:hint="Nombre de usuario"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:textSize="19sp"
            android:textColor="#000000"
            android:textColorHint="#404040"
            android:fontFamily="serif"
            android:singleLine="true" />

        <!-- CORREO -->
        <EditText
            android:id="@+id/etCorreo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_field"
            android:hint="Correo"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:textSize="19sp"
            android:textColor="#000000"
            android:textColorHint="#404040"
            android:fontFamily="serif"
            android:inputType="textEmailAddress"
            android:singleLine="true" />

        <!-- CONTRASEÑA -->
        <EditText
            android:id="@+id/etClave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_field"
            android:hint="Contraseña"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:textSize="19sp"
            android:textColor="#000000"
            android:textColorHint="#404040"
            android:fontFamily="serif"
            android:inputType="textPassword"
            android:singleLine="true" />

        <!-- CONFIRMAR CONTRASEÑA -->
        <EditText
            android:id="@+id/etClaveComfirm"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_field"
            android:hint="Confirmar contraseña"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:textSize="19sp"
            android:textColor="#000000"
            android:textColorHint="#404040"
            android:fontFamily="serif"
            android:inputType="textPassword"
            android:singleLine="true" />

        <!-- MENSAJE DE ESTADO / ERROR CENTRADO -->
        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textAlignment="center"
            android:textSize="16sp"
            android:textColor="@color/marfil" />

        <!-- BOTON REGISTRARSE -->
        <Button
            android:id="@+id/btnRegistrar"
            android:layout_width="215dp"
            android:layout_height="50dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:text="Registrarse"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:textAllCaps="false"
            android:backgroundTint="@color/rojo_carmesi"/>

    </LinearLayout>

    <!-- PIE DE PAGINA -->
    <View
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@color/rojo_carmesi" />

</LinearLayout>
