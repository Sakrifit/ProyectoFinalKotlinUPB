<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Encabezado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:background="#D9D9D9">

        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text=" "
            android:textColor="#333333"
            android:textSize="28sp"
            android:background="@android:drawable/editbox_background" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="¡Bienvenido, Anderson!"
            android:textColor="#111111"
            android:textStyle="bold"
            android:textSize="20sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnVolver"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:gravity="center"
        android:paddingHorizontal="14dp"
        android:text="←"
        android:textColor="#000000"
        android:textSize="30sp"
        android:clickable="true"
        android:focusable="true" />

    <!-- Tabla de reservas -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="8dp"
        android:fillViewport="true"
        android:scrollbars="horizontal">

        <TableLayout
            android:id="@+id/tablaReservas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:stretchColumns="*"
            android:shrinkColumns="*"
            android:background="#FFFFFF">

            <TableRow android:background="#FFFFFF">
                <TextView style="@style/TablaEncabezado" android:text="Sala" />
                <TextView style="@style/TablaEncabezado" android:text="Asientos" />
                <TextView style="@style/TablaEncabezado" android:text="Nombre" />
                <TextView style="@style/TablaEncabezado" android:text="Fecha" />
                <TextView style="@style/TablaEncabezado" android:text="Hora" />
                <TextView style="@style/TablaEncabezado" android:text="Precio" />
            </TableRow>
            <TableRow>
                <TextView style="@style/TablaCelda" android:text="999" />
                <TextView style="@style/TablaCelda" android:text="164" />
                <TextView style="@style/TablaCelda" android:text="Avengers: Doomsday" />
                <TextView style="@style/TablaCelda" android:text="18/12/2026" />
                <TextView style="@style/TablaCelda" android:text="23:59" />
                <TextView style="@style/TablaCelda" android:text="$50.000" />
            </TableRow>
        </TableLayout>
    </HorizontalScrollView>

    <!-- Controles de reserva -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spinnerPelicula"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"/>
                <!--android:prompt="Nombre de la película" -->

            <Button
                android:id="@+id/btnFormaPago"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Forma de pago"
                android:textAllCaps="false" />
        </LinearLayout>

        <Spinner
            android:id="@+id/spinnerPersonas"
            android:layout_width="190dp"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"/>
            <!--android:prompt="Cantidad de personas" -->

        <Button
            android:id="@+id/btnReservar"
            android:layout_width="180dp"
            android:layout_height="52dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:text="Reservar"
            android:textAllCaps="false"
            android:textSize="18sp" />
    </LinearLayout>
</LinearLayout>
