<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true"
    android:backgroundTint="@color/carbon_oscuro">

    <!-- ENCABEZADO -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="165dp"
        android:background="@color/rojo_carmesi">

        <!-- CIRCULO DECORATIVO -->
        <View
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="top|end"
            android:background="@drawable/dante"
            android:translationX="15dp"
            android:translationY="-40dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center"
            android:paddingBottom="14dp"
            android:text="Inicio de sesión"
            android:textColor="#000000"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="serif" />

    </FrameLayout>

    <!-- CONTENIDO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="top|center_horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp"        >

        <!-- USUARIO -->
        <EditText
            android:id="@+id/etCorreo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:hint="Correo"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_field"
            android:textSize="19sp"
            android:textColor="#000000"
            android:textColorHint="#404040"
            android:fontFamily="serif"
            android:singleLine="true"
            android:inputType="textEmailAddress" />

        <!-- CONTRASEÑA -->
        <EditText
            android:id="@+id/etClave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:hint="Contraseña"
            android:background="@drawable/bg_field"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:textSize="19sp"
            android:textColor="#000000"
            android:textColorHint="#404040"
            android:fontFamily="serif"
            android:inputType="textPassword"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textSize="16sp"
            android:textColor="@color/marfil" />

        <!-- BOTON INICIAR SESION -->
        <Button
            android:id="@+id/btnIngresar"
            android:layout_width="215dp"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:text="Iniciar sesión"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:textAllCaps="false"
            android:backgroundTint="@color/rojo_carmesi"/>

        <!-- TEXTO SIN CUENTA -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="¿No tienes cuenta?"
            android:textColor="@color/marfil"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="serif" />

        <!-- BOTON REGISTRARSE -->
        <Button
            android:id="@+id/btnRegistrate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="48dp"
            android:paddingHorizontal="16dp"
            android:text="@string/registrate"
            android:background="@android:color/transparent"
            android:textColor="@color/ambar"
            android:textSize="21sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:textAllCaps="false"
            android:elevation="0dp" />

    </LinearLayout>

    <!-- PIE DECORATIVO -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:background="#D9D9D9">

        <View
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="start|bottom"
            android:background="@drawable/dante"
            android:elevation="4dp"
            android:translationX="-25dp"
            android:translationY="30dp"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center|end"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:background="@color/rojo_carmesi">

            <EditText
                android:id="@+id/etC1"
                android:layout_width="56dp"
                android:layout_height="42dp"
                android:background="#000000" />

            <EditText
                android:id="@+id/etC2"
                android:layout_width="56dp"
                android:layout_height="42dp"
                android:layout_marginStart="20dp"
                android:background="#000000" />

            <EditText
                android:id="@+id/etC3"
                android:layout_width="56dp"
                android:layout_height="42dp"
                android:layout_marginStart="20dp"
                android:background="#000000" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
