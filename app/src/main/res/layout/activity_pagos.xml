<?xml version="1.0" encoding="utf-8"?>
<!--Linear layout que contiene toda la información de los pagos realizados -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:background="#D9D9D9">

        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text=" "
            android:textColor="#333333"
            android:textSize="28sp"
            android:background="@android:drawable/editbox_background" />

        <TextView
            android:id="@+id/tvBienvenida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="¡Bienvenido, Admin!"
            android:textColor="#111111"
            android:textStyle="bold"
            android:textSize="20sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cerrar sesión"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back" />
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <Button
            android:id="@+id/btnListaFilmes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lista de filmes"
            android:textAllCaps="false"
            android:layout_marginEnd="12dp"/>

    </LinearLayout>
    <!-- Tabla de pagos -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="8dp"
        android:fillViewport="true"
        android:scrollbars="horizontal">

        <TableLayout
            android:id="@+id/tablaPagos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:stretchColumns="*"
            android:shrinkColumns="*">
            <TableRow android:background="#FFFFFF">
                <TextView style="@style/TablaEncabezado" android:text="Usuario" />
                <TextView style="@style/TablaEncabezado" android:text="Personas" />
                <TextView style="@style/TablaEncabezado" android:text="Fecha" />
                <TextView style="@style/TablaEncabezado" android:text="Hora" />
                <TextView style="@style/TablaEncabezado" android:text="Cuenta" />
            </TableRow>
        </TableLayout>
    </HorizontalScrollView>

    <!-- Escribir la información que se ingresara al CRUD -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="16dp"
        android:fillViewport="true">

        <TableLayout
            android:id="@+id/tablaCRUD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="*">
            <TableRow>
                <EditText style="@style/TablaEncabezado" android:hint="Usuario"
                    android:id="@+id/etUsuario"/>
                <EditText style="@style/TablaEncabezado" android:hint="Personas"
                    android:id="@+id/etPersonas"/>
                <EditText style="@style/TablaEncabezado" android:hint="Fecha"
                    android:id="@+id/etFecha"/>
                <EditText style="@style/TablaEncabezado" android:hint="Hora"
                    android:id="@+id/etHora"/>
                <EditText style="@style/TablaEncabezado" android:hint="Cuenta"
                    android:id="@+id/etCuenta"/>
            </TableRow>
        </TableLayout>
    </HorizontalScrollView>
    <!-- Controles de CRUD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/btnCrear"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Crear"
            android:scaleType="centerInside"
            android:src="@drawable/plus_circle_svgrepo_com" />
        <ImageButton
            android:id="@+id/btnBuscar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Buscar"
            android:scaleType="centerInside"
            android:src="@drawable/magnifying_glass_8_svgrepo_com" />
        <TextView android:id="@+id/btnAccionCentral" style="@style/AccionCentral" android:text="" />
        <ImageButton
            android:id="@+id/btnActualizar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Actualizar"
            android:scaleType="centerInside"
            android:src="@drawable/update_svgrepo_com" />
        <ImageButton
            android:id="@+id/btnEliminar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Eliminar"
            android:scaleType="centerInside"
            android:src="@drawable/trashcan_svgrepo_com" />
    </LinearLayout>
</LinearLayout>

