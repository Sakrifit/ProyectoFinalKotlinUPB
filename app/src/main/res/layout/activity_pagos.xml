<?xml version="1.0" encoding="utf-8"?>
<!--Linear layout que contiene toda la información de los pagos realizados -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gris_claro"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:background="@color/rojo_carmesi">

        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text=" "
            android:textColor="#333333"
            android:textSize="28sp"
            android:background="@drawable/limbus" />

        <TextView
            android:id="@+id/tvBienvenida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="¡Bienvenido, Admin!"
            android:textColor="#111111"
            android:textStyle="bold"
            android:textSize="20sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cerrar sesión"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back" />
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <Button
            android:id="@+id/btnListaFilmes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lista de filmes"
            android:textAllCaps="false"
            android:backgroundTint="@color/rojo_carmesi"/>

    </LinearLayout>
    <!-- Tabla de pagos -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="8dp"
        android:fillViewport="true"
        android:scrollbars="horizontal">

        <TableLayout
            android:id="@+id/tablaPagos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:stretchColumns="*"
            android:shrinkColumns="*">
            <TableRow android:background="#FFFFFF">
                <TextView style="@style/TablaEncabezado" android:text="Usuario"
                    android:textColor="@color/ambar"
                    android:background="@color/carbon_oscuro"/>
                <TextView style="@style/TablaEncabezado" android:text="Personas"
                    android:textColor="@color/ambar"
                    android:background="@color/gris_menos_oscuro"/>
                <TextView style="@style/TablaEncabezado" android:text="Sala"
                    android:textColor="@color/ambar"
                    android:background="@color/carbon_oscuro"/>
                <TextView style="@style/TablaEncabezado" android:text="Fecha"
                    android:textColor="@color/ambar"
                    android:background="@color/gris_menos_oscuro"/>
                <TextView style="@style/TablaEncabezado" android:text="Hora"
                    android:textColor="@color/ambar"
                    android:background="@color/carbon_oscuro"/>
                <TextView style="@style/TablaEncabezado" android:text="Cuenta"
                    android:textColor="@color/ambar"
                    android:background="@color/gris_menos_oscuro"/>
            </TableRow>
        </TableLayout>
    </HorizontalScrollView>
    <!-- Espaciador flexible para empujar la sección inferior hacia abajo cuando sobra pantalla -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@color/rojo_carmesi"
        android:orientation="vertical">

        <!-- Escribir la información que se ingresara al CRUD -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:fillViewport="true">

            <TableLayout
                android:id="@+id/tablaCRUD"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:stretchColumns="*">

                <TableRow>
                    <EditText
                        android:id="@+id/etUsuario"
                        style="@style/TablaEncabezado"
                        android:background="#FFFFFF"
                        android:hint="Usuario"
                        android:minWidth="48dp"
                        android:layout_marginEnd="1dp"
                        android:textColor="#111111"
                        android:textColorHint="#888888" />

                    <EditText
                        android:id="@+id/etPersonas"
                        style="@style/TablaEncabezado"
                        android:background="#FFFFFF"
                        android:hint="Personas"
                        android:minWidth="48dp"
                        android:layout_marginEnd="1dp"
                        android:textColor="#111111"
                        android:textColorHint="#888888" />

                    <EditText
                        android:id="@+id/etSala"
                        style="@style/TablaEncabezado"
                        android:layout_marginEnd="1dp"
                        android:background="#FFFFFF"
                        android:hint="Sala"
                        android:minWidth="48dp"
                        android:textColor="#111111"
                        android:textColorHint="#888888" />

                    <EditText
                        android:id="@+id/etFecha"
                        style="@style/TablaEncabezado"
                        android:layout_marginEnd="2dp"
                        android:background="#FFFFFF"
                        android:hint="Fecha"
                        android:minWidth="48dp"
                        android:textColor="#111111"
                        android:textColorHint="#888888" />

                    <EditText
                        android:id="@+id/etHora"
                        style="@style/TablaEncabezado"
                        android:layout_marginEnd="2dp"
                        android:background="#FFFFFF"
                        android:hint="Hora"
                        android:minWidth="48dp"
                        android:textColor="#111111"
                        android:textColorHint="#888888" />

                    <EditText
                        android:id="@+id/etCuenta"
                        style="@style/TablaEncabezado"
                        android:background="#FFFFFF"
                        android:hint="Cuenta"
                        android:minWidth="48dp"
                        android:textColor="#111111"
                        android:textColorHint="#888888" />
                </TableRow>
            </TableLayout>
        </HorizontalScrollView>

        <!-- Controles de CRUD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageButton
                android:id="@+id/btnCrear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Crear"
                android:scaleType="centerInside"
                android:src="@drawable/plus_circle_svgrepo_com" />

            <ImageButton
                android:id="@+id/btnBuscar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Buscar"
                android:scaleType="centerInside"
                android:src="@drawable/magnifying_glass_8_svgrepo_com" />

            <TextView
                android:id="@+id/tvLogo"
                style="@style/AccionCentral"
                android:text=""
                android:background="@drawable/dante"/>

            <ImageButton
                android:id="@+id/btnActualizar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Actualizar"
                android:scaleType="centerInside"
                android:src="@drawable/update_svgrepo_com" />

            <ImageButton
                android:id="@+id/btnEliminar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Eliminar"
                android:scaleType="centerInside"
                android:src="@drawable/trashcan_svgrepo_com" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
